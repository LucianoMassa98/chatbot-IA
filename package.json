{
  "name": "multichannel-chatbot-backend",
  "version": "1.0.0",
  "description": "Production-ready MVC backend for Meta multichannel chatbot (WhatsApp, Instagram, Facebook Messenger)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "start:migrate": "sequelize-cli db:migrate && node src/server.js",
    "dev": "nodemon src/server.js",
    "verify": "node verify-setup.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed:generate": "sequelize-cli seed:generate",
    "seed": "sequelize-cli db:seed:all",
    "test": "jest --detectOpenHandles",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "chatbot",
    "whatsapp",
    "instagram",
    "facebook",
    "messenger",
    "meta",
    "mvc",
    "express"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
