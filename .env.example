# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://tu-dominio.com

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=chatbot_user
DB_PASS=tu_password_seguro
DB_NAME=yemas_del_sol

# ── WhatsApp Business Cloud API (Meta) ────────────────────────
META_VERIFY_TOKEN=tu_verify_token_secreto
META_ACCESS_TOKEN=tu_meta_access_token
META_PHONE_NUMBER_ID=tu_phone_number_id

# ── Mercado Pago ──────────────────────────────────────────────
MP_ACCESS_TOKEN=tu_mp_access_token
MP_PUBLIC_KEY=tu_mp_public_key
# Opcional: secret para validar firma del webhook (recomendado en producción)
MP_WEBHOOK_SECRET=
# URLs de retorno luego del pago
MP_SUCCESS_URL=https://tu-dominio.com/payment/success
MP_FAILURE_URL=https://tu-dominio.com/payment/failure
MP_PENDING_URL=https://tu-dominio.com/payment/pending

# ── Google OAuth (CRM) ────────────────────────────────────────
# Obtenelo en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# URL del frontend React en desarrollo o producción
CRM_FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ── Session ───────────────────────────────────────────────────
SESSION_TIMEOUT=3600

# ── AI (Google Gemini — fallback) ─────────────────────────────
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
# Dejar vacío para usar el prompt por defecto del sistema
AI_SYSTEM_PROMPT=
